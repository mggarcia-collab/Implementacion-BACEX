# Copia este archivo como .env para desarrollo local, o usa estos mismos
# nombres como variables de entorno/secrets en Azure Container Apps.

# Azure SQL (vestadbazure)
DB_SERVER=
DB_USER=
DB_PASSWORD=

# Firma de los tokens de sesión (cualquier cadena larga y secreta)
JWT_SECRET=

# Puerto en el que escucha el servidor (Azure Container Apps lo define solo; opcional en local)
PORT=3000

# URL pública del Container App (https://<app>.<region>.azurecontainerapps.io),
# necesaria para que CORS acepte peticiones del propio dominio en producción.
PUBLIC_URL=
